clear; clc; close all;

%% ===================== 사용자 설정 =====================
filename   = 'qube_data.csv';

Ts_user    = 0.02;   % 목표 샘플링(일단 0.02로 두되, 아래에서 time으로도 추정 가능)

start_idx  = 500;
end_idx    = 1500;

col_u      = 'u_noisy';
col_theta  = 'theta';   % 베이스 각도
col_alpha  = 'alpha';   % 진자 각도

nx = 4;

% LQR 가중치(시작점)
Q = diag([1000, 1000, 1000, 10]);
R = 1;

% 옵저버 속도: 폐루프 극 크기 * factor
obs_speed_factor = 0.4;

% ====== “업라이트 근처 데이터만” 사용 옵션(강력 추천) ======
use_upright_window = true;
alpha_max = 0.35;   % |alpha| < alpha_max 구간만 사용 (rad)  (0.25~0.5 사이로 조정)
theta_max = 0.8;    % |theta| < theta_max (rad) (너무 빡세면 끄세요)

%% ===================== 1) 데이터 로드 =====================
T = readtable(filename);
T = T(start_idx:end_idx, :);

t_raw = T.Time;
u_raw = T.(col_u);
theta_raw = T.(col_theta);
alpha_raw = T.(col_alpha);

good = isfinite(t_raw) & isfinite(u_raw) & isfinite(theta_raw) & isfinite(alpha_raw);
t_raw = t_raw(good);
u_raw = u_raw(good);
theta_raw = theta_raw(good);
alpha_raw = alpha_raw(good);

% 시간 0 기준
t_raw = t_raw - t_raw(1);

% Ts 추정(시간스탬프가 약간 흔들리므로 median 사용)
Ts_time = median(diff(t_raw));
fprintf('Ts_user = %.6f, Ts_time(median) = %.6f\n', Ts_user, Ts_time);

Ts = Ts_user;  % 일단 사용자는 0.02로 고정 (원하면 Ts=Ts_time로 바꿔도 됨)

%% ===================== 2) 각도 전처리 (rad 가정) =====================
theta = theta_raw;
alpha = alpha_raw;

% unwrap으로 ±pi 점프 제거
theta = unwrap(theta);
alpha = unwrap(alpha);

% 업라이트 기준 맞추기:
% alpha가 처음에 -pi 근처에 붙어있으면, "업라이트를 0"으로 보려면 pi shift가 필요할 수 있음.
% (정확한 기준은 실험 정의에 따라 다르지만, 현재 CSV는 -pi 근처로 시작하므로 아래가 보통 유효)
N0 = min(50, numel(alpha));
a0 = mean(alpha(1:N0));

if abs(wrapToPi(a0)) > pi/2
    % -pi 또는 +pi 쪽이면 pi만큼 이동해서 0 근처로
    alpha = alpha - sign(a0)*pi;
    alpha = unwrap(alpha);
    fprintf('alpha를 %.3f*pi 만큼 shift하여 업라이트를 0 근처로 맞췄습니다.\n', sign(a0));
end

% 오프셋 제거(초기 평균)
theta = theta - mean(theta(1:N0));
alpha = alpha - mean(alpha(1:N0));
u = u_raw - mean(u_raw(1:N0));

% 출력 벡터는 y=[alpha, theta] (당신이 말한 순서 유지)
y = [alpha, theta];

%% ===================== 3) 업라이트 근처 데이터만 선택(권장) =====================
if use_upright_window
    mask = abs(alpha) < alpha_max & abs(theta) < theta_max;

    % 너무 듬성듬성하면 식별이 깨지니, mask 중 가장 긴 연속 구간을 사용
    idx = find(mask);
    if numel(idx) < 200
        warning('업라이트 구간 샘플이 너무 적습니다(%d). use_upright_window=false를 고려하세요.', numel(idx));
    else
        % 가장 긴 연속 구간 찾기
        d = diff(idx);
        cuts = [0; find(d>1); numel(idx)];
        bestLen = 0; bestSeg = [];
        for k = 1:numel(cuts)-1
            seg = idx(cuts(k)+1 : cuts(k+1));
            if numel(seg) > bestLen
                bestLen = numel(seg);
                bestSeg = seg;
            end
        end
        fprintf('업라이트 근처 연속 구간 사용: %d samples\n', bestLen);

        t_raw = t_raw(bestSeg);
        u = u(bestSeg);
        y = y(bestSeg,:);
    end
end

%% ===================== 4) iddata 생성 + 추정/검증 분리 =====================
z = iddata(y, u, Ts, 'InputName','u', 'OutputName',{'alpha','theta'});
z = detrend(z);

N = length(z.SamplingInstants);
Ne = floor(0.7*N);
z_est = z(1:Ne);
z_val = z(Ne+1:end);

%% ===================== 5) ssest 식별 (idss 템플릿 없이) =====================
opt = ssestOptions('Focus','simulation', 'Display','on', 'InitialState','estimate');
% opt.EnforceStability = true;   % 필요하면 켜세요

% ssest는 기본적으로 D=0(Feedthrough 없음)으로 둡니다. :contentReference[oaicite:2]{index=2}
identified_sys = ssest(z_est, nx, 'Ts', Ts, opt);

[Ad, Bd, Cd, Dd] = ssdata(identified_sys);

disp('==== Identified discrete model ====');
disp('Ad ='); disp(Ad);
disp('Bd ='); disp(Bd);
disp('Cd ='); disp(Cd);
disp('Dd ='); disp(Dd);

%% 검증(필수)
figure; compare(z_val, identified_sys); grid on;
title('Validation: compare(z\_val, identified\_sys)');

%% ===================== 6) LQR =====================
[K,~,~] = dlqr(Ad, Bd, Q, R);
H = -K;

disp('==== LQR ====');
disp('K ='); disp(K);
disp('eig(Ad-Bd*K) ='); disp(eig(Ad - Bd*K));

%% ===================== 7) Observer L (폐루프 극 기반) =====================
p_cl = eig(Ad - Bd*K);
obs_poles =[0.4 0.41 0.42 0.43];

% 너무 밖으로 나가면/너무 느리면 방지
obs_poles = max(min(obs_poles, 0.95), -0.95);

L = place(Ad', Cd', obs_poles).';

disp('==== Observer ====');
disp('obs_poles ='); disp(obs_poles.');
disp('L ='); disp(L);

%% ===================== 8) 동적 컨트롤러 실현 (Dd 포함 일반식) =====================
% innovation observer:
% xhat+ = (Ad - L*Cd)*xhat + (Bd - L*Dd)*u + L*y
% u     = H*xhat
% => xhat+ = [Ad - L*Cd + (Bd - L*Dd)*H] xhat + L*y
F = Ad - L*Cd + (Bd - L*Dd)*H;
G = L;

disp('==== Controller matrices ====');
disp('F ='); disp(F);
disp('G ='); disp(G);
disp('H ='); disp(H);
disp('abs(eig(F)) ='); disp(abs(eig(F)));

%% ===================== 9) numpy 포맷 출력 =====================
print_numpy('F', F, 4);
print_numpy('G', G, 4);
print_numpy('H', H, 4);

%% ===================== local function =====================
function print_numpy(name, M, prec)
    if nargin < 3, prec = 4; end
    fmt = ['%0.' num2str(prec) 'f'];

    if isvector(M)
        fprintf('%s = np.array([ ', name);
        for k = 1:numel(M)
            fprintf(fmt, M(k));
            if k < numel(M), fprintf(', '); end
        end
        fprintf(' ], dtype=np.float64)  # shape (%d,)\n\n', numel(M));
    else
        fprintf('%s = np.array([\n', name);
        for i = 1:size(M,1)
            fprintf('    [ ');
            for j = 1:size(M,2)
                fprintf(fmt, M(i,j));
                if j < size(M,2), fprintf(', '); end
            end
            if i < size(M,1)
                fprintf(' ],\n');
            else
                fprintf(' ]\n');
            end
        end
        fprintf('], dtype=np.float64)\n\n');
    end
end
